<?xml version="1.0"?>
<!-- Миниатюра services.config АС CF. Инварианты, на которых стоят тесты:
     1. у ICalcResult есть вложенный <interceptors><add/></interceptors> —
        обход по `.//add` подобрал бы его как сервис;
     2. у CalcDxExcel имя не совпадает ни с классом, ни с именем интерфейса —
        значит, якорь не выводится из класса;
     3. команды две, чтобы фильтр по team было на чём проверить. -->
<servicesConfiguration>
    <dotNetServices>

        <add name="ICalcResult"
             assembly="Sbt.Cashflow.Grid.Services.CalcResult"
             class="Sbt.Cashflow.Grid.Services.CalcResult.CalcResult"
             maxPerNodeCount="1"
             roles="serviceNode"
             team="Core">
            <interceptors>
                <add type="Sbt.CMS.Cashflow.Service.IgniteServiceUserPropagator, Sbt.CMS.Cashflow.Service" />
            </interceptors>
        </add>

        <add name="CalcDxExcel"
             assembly="Sbt.Cashflow.Grid.Services.CalcService"
             class="Sbt.Cashflow.Grid.Services.CalcService.DXExcelCalcService"
             maxPerNodeCount="1"
             roles="serviceNode"
             team="Core" />

        <add name="IBlockFilesService"
             assembly="Sbt.Cashflow.Grid.Services.BlockFilesService"
             class="Sbt.Cashflow.Grid.Services.BlockFilesService.BlockFilesService"
             maxPerNodeCount="1"
             roles="serviceNode"
             team="TVM">
            <interceptors>
                <add type="Sbt.CMS.Cashflow.Service.IgniteServiceUserPropagator, Sbt.CMS.Cashflow.Service" />
            </interceptors>
        </add>

    </dotNetServices>
</servicesConfiguration>
