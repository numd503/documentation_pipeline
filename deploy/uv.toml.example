# Настройки uv для этой поставки — для закрытого контура, где пакеты приходят
# не с pypi.org, а из внутреннего зеркала.
#
# uv читает этот файл из каталога, указанного в `--project`, поэтому он действует
# на `uv lock`, `uv sync` и `uv run` независимо от того, откуда их зовут. Правьте
# его, а не запоминайте переменные окружения.
#
# Установщик подставляет адрес зеркала сам:
#     ./deploy/install.sh <репозиторий> --index https://зеркало/repository/pypi/simple
#
# ВАЖНО: в TOML ключи верхнего уровня обязаны идти ДО первой таблицы. Если
# перенести `native-tls` под `[[index]]`, он станет полем индекса и молча
# перестанет действовать.

# Системное хранилище сертификатов вместо вшитого в uv. Без этого корпоративный
# TLS-прокси даёт `invalid peer certificate`: он подписывает соединения
# сертификатом внутреннего удостоверяющего центра, которого в наборе uv нет.
#
# Если системное хранилище тоже без него — положить корневой сертификат компании
# и указать его явно: SSL_CERT_FILE=/путь/до/corp-root-ca.pem
#
# Свежий uv на эту строку РУГАЕТСЯ («deprecated, use `system-certs`») — и это
# нормально, настройка работает. Менять имя на `system-certs` можно только
# зная версию uv на машине: неизвестный ключ uv.toml не игнорирует, а падает
# с ошибкой разбора, поэтому новое имя сломает установку на старом uv,
# а старое перестанет работать, лишь когда его выпилят совсем.
native-tls = true

# Не скачивать интерпретатор. Иначе uv, не найдя подходящего Python, пойдёт за
# сборкой на github.com и упрётся в тот же прокси — но сообщение будет уже про
# загрузку Python, а не про то, что интерпретатор не найден.
python-downloads = "never"

# Внутреннее зеркало. `default = true` означает «вместо PyPI, а не в дополнение
# к нему»: на закрытом контуре обращение к pypi.org должно быть невозможным,
# а не маловероятным.
[[index]]
name = "corp"
url = "https://ЗАПОЛНИТЬ/repository/pypi/simple"
default = true
