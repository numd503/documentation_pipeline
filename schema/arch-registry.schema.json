    "Source": {
      "additionalProperties": false,
      "description": "Откуда взята запись: файл и место в нём.\n\nЗапись без источника не принимается на уровне загрузки. Причина та же,\nпо которой в правилах отсева обязателен `reason`: безымянная запись через\nмесяц неотличима от выдумки, а выдумка в реестре становится уверенно\nневерным ребром графа — худшим видом ошибки (Р6).",
      "properties": {
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "hash": {
          "default": "",
          "title": "Hash",
          "type": "string"
        },
        "record": {
          "default": "",
          "title": "Record",
          "type": "string"
        }
      },
      "required": [
        "file"
      ],
      "title": "Source",
      "type": "object"
    }
