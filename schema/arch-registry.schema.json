  "additionalProperties": false,
  "description": "Содержимое `arch-registry.yaml`.\n\nПустой реестр — валидное состояние, а не ошибка: на репозитории без\nреестров граф строится и без него, и «реестров здесь нет» — успешный\nисход разведки, а не пустой.",
  "properties": {
    "records": {
      "default": [],
      "items": {
        "discriminator": {
          "mapping": {
            "data": "#/$defs/DataRecord",
            "entry_point": "#/$defs/EntryPointRecord",
            "layer": "#/$defs/LayerRecord",
            "seam": "#/$defs/SeamRecord"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/EntryPointRecord"
          },
          {
            "$ref": "#/$defs/DataRecord"
          },
          {
            "$ref": "#/$defs/SeamRecord"
          },
          {
            "$ref": "#/$defs/LayerRecord"
          }
        ]
      },
      "title": "Records",
      "type": "array"
    },
    "version": {
      "default": "1",
      "title": "Version",
      "type": "string"
    }
