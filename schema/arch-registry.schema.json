{
  "$defs": {
    "DataField": {
      "additionalProperties": false,
      "description": "Поле узла данных: внутреннее имя, вид и человеческое название.\n\n`kind` — свободная строка, а не словарь: перечень видов полей у платформы\nзаведомо неполон (G05b п. 4 требует читать их по префиксу, а не по белому\nсписку). Ошибиться здесь дешевле, чем потерять поле.",
      "properties": {
        "display_name": {
          "default": "",
          "title": "Display Name",
          "type": "string"
        },
        "kind": {
          "default": "",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "references": {
          "default": "",
          "title": "References",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "DataField",
      "type": "object"
    },
