              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via Action"
        }
      },
      "required": [
        "file",
        "line",
        "key",
        "confidence"
      ],
      "title": "WebCall",
      "type": "object"
    }
